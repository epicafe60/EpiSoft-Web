# Copy to docker/.env on the server (never commit it).
# Must match EPISOFT_APP_PASSWORD in deploy/db/.env.
EPISOFT_APP_PASSWORD=change-me
# Public address: a domain (Let's Encrypt) or https://<LAN IP> (Caddy local CA).
SITE_ADDRESS=https://192.168.1.10
APP_URL=https://192.168.1.10
HTTP_PORT=80
HTTPS_PORT=443
# SMTP for e-mails (§4.16). Leave SMTP_HOST empty to keep e-mails in the outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Épicafé <epicafe60@gmail.com>
LOG_LEVEL=info
