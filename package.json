{
  "name": "episoft-web",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,json,css,html}\" \"*.{json,js}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,tsx,json,css,html}\" \"*.{json,js}\"",
    "db:generate": "pnpm --filter @episoft/db generate",
    "db:migrate": "pnpm --filter @episoft/db migrate",
    "db:seed": "pnpm --filter @episoft/db seed",
    "legacy:migrate": "pnpm --filter @episoft/db legacy",
    "e2e": "pnpm --filter @episoft/e2e e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module"
}
