# Copy to .env on the server (setup.sh does it and generates random passwords).
# NEVER commit the real .env.
POSTGRES_PASSWORD=change-me
EPISOFT_APP_PASSWORD=change-me
EPISOFT_RO_PASSWORD=change-me
# Address the port is published on: the server's LAN IP (reachable from the LAN only),
# or 127.0.0.1 (reachable from the server itself only).
PG_BIND_ADDR=192.168.1.10
PG_PORT=5432

# --- Backup scripts (backup.sh, restore-test.sh) ---------------------------------------------
# Where the application listens, and the shared secret (same value as BACKUP_REPORT_TOKEN in
# docker/.env): the scripts report each result there, which feeds « À surveiller ».
BACKUP_API_URL=http://127.0.0.1:3000
BACKUP_REPORT_TOKEN=
# Copy outside the server (a backup on the same disk does not survive a dead disk): one of
#   BACKUP_RSYNC_DEST=user@other-machine:/backups/episoft/
#   BACKUP_RCLONE_DEST=mydrive:episoft-backups
BACKUP_KEEP_DAYS=14
