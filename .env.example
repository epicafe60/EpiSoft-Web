# Copy to .env (git-ignored). Used by apps/api and packages/db.
NODE_ENV=development
# Application role (read/write). Password: EPISOFT_APP_PASSWORD in deploy/db/.env
DATABASE_URL=postgres://episoft_app:change-me@127.0.0.1:5432/episoft
API_HOST=127.0.0.1
API_PORT=3000
# Public URL of the web app, used in e-mail links (password reset).
APP_URL=http://localhost:5173
# Set to true behind HTTPS (Caddy). Secure cookies are required in production.
COOKIE_SECURE=false
# Legacy EpiSoft config (read only), used by the legacy migration script.
LEGACY_CONFIG=C:\Datas\Dev\Episoft\EpiSoft.config
